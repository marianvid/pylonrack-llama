{
  "name": "llama.cpp",
  "version": "1.0",
  "start": "zsh start.sh",
  "startup_delay": 5,
  "port": 8765,
  "heartbeat_interval": 5,
  "controls": [
    {
      "id": "model_select",
      "type": "dropdown",
      "label": "Model"
    },
    {
      "id": "toggle",
      "type": "button",
      "label": "Start",
      "style": "primary"
    },
    {
      "id": "update",
      "type": "button",
      "label": "Update",
      "style": "secondary",
      "badge": false
    },
    {
      "id": "status_label",
      "type": "label",
      "value": "Idle",
      "style": "default"
    }
  ]
}
